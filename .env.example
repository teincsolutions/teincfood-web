# Deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App Store / Play Store links (placeholders — fill in with real URLs before go-live)
# Public values — set as GitHub Actions variables for CI builds.
NEXT_PUBLIC_BUYER_APP_STORE=https://apps.apple.com/app/teincfood/id000000000
NEXT_PUBLIC_BUYER_PLAY_STORE=https://play.google.com/store/apps/details?id=com.teincfood.buyer
NEXT_PUBLIC_BUSINESS_APP_STORE=https://apps.apple.com/app/teincfood-business/id000000001
NEXT_PUBLIC_BUSINESS_PLAY_STORE=https://play.google.com/store/apps/details?id=com.teincfood.business

# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_CONTACT_EMAIL=hello@teincfood.com

# ── Public guest chat widget ───────────────────────────────────────────────
# Backend the chat widget talks to. Leave empty to use the testing backend
# (https://testing-food.teincsolutions.com). Set these per environment:
#   production  https://food.teincsolutions.com/api/v1  wss://food.teincsolutions.com/ws
#   testing     https://testing-food.teincsolutions.com/api/v1  wss://testing-food.teincsolutions.com/ws
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Cloudflare Turnstile PUBLIC site key for the guest chat widget.
# This is a public value (it ships in the browser bundle) -> put it in GitHub
# VARIABLES, not secrets. The matching SECRET key goes to the backend as the
# GUEST_CAPTCHA_SECRET secret - BOTH must come from the same Turnstile widget,
# otherwise guest chats are rejected with CAPTCHA_FAILED.
# Leave empty to keep the captcha off (no Turnstile box is rendered).
# Cloudflare test keys (always pass, use locally):
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Telemetry (shared @teincfood/observability collector). Both are inlined at
# build time. Leave the URL empty to disable telemetry (library no-ops). The
# key is a static, per-environment ingest key — like a Sentry DSN, not a user
# secret — sent as X-Telemetry-Key.
NEXT_PUBLIC_TELEMETRY_URL=
NEXT_PUBLIC_TELEMETRY_KEY=

# Account deletion (server-side proxy to the backend API)
# Also proxies the website contact form to the backend (/contact).
# The base is version-less on purpose — the API version is appended from
# TEINCFOOD_API_VERSION, so a future v2 needs no code change.
TEINCFOOD_API_BASE_URL=http://localhost:4000/api
TEINCFOOD_API_VERSION=v1

# Social sign-in for account deletion verification (id_token providers)# NEXT_PUBLIC_GOOGLE_CLIENT_ID: Google Cloud OAuth 2.0 **Web** client ID.
#   Must list this site's origin (http://localhost:3000 or https://…) in the
#   client's "Authorized JavaScript origins" or GSI popup will be refused.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_CLIENT_ID: Apple "Sign in with Apple" **Services ID**, whose
#   "Return URL" must be set to this site's origin (https only — no localhost).
#   Without it the Apple button stays disabled; the buyer app's native Apple
#   sign-in offers no Services ID, so this must be created in the Apple portal.
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Universal links (/.well-known association files served by this site).
# Team ID, bundle ID, package name and cert fingerprints are public by design —
# Apple/Play publish them. Comma-separate multiple Android fingerprints.
# Real values go into CI env for builds; defaults match the business app IDs.
APPLE_TEAM_ID=
IOS_BUSINESS_BUNDLE_ID=com.teincfood.business
IOS_BUYER_BUNDLE_ID=com.teincfood.app
ANDROID_BUSINESS_PACKAGE=com.teincfood.business
ANDROID_SHA256_FINGERPRINTS=