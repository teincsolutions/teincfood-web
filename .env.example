# Deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App Store / Play Store links (fill in with real URLs before go-live)
NEXT_PUBLIC_BUYER_APP_STORE=
NEXT_PUBLIC_BUYER_PLAY_STORE=
NEXT_PUBLIC_BUSINESS_APP_STORE=
NEXT_PUBLIC_BUSINESS_PLAY_STORE=

# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_CONTACT_EMAIL=hello@teincfood.com

# Account deletion (server-side proxy to the backend API)
# Also proxies the website contact form to the backend (/contact).
TEINCFOOD_API_BASE_URL=http://localhost:4000/api/v1

# Social sign-in for account deletion verification (id_token providers)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: Google Cloud OAuth 2.0 **Web** client ID.
#   Must list this site's origin (http://localhost:3000 or https://…) in the
#   client's "Authorized JavaScript origins" or GSI popup will be refused.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_CLIENT_ID: Apple "Sign in with Apple" **Services ID**, whose
#   "Return URL" must be set to this site's origin (https only — no localhost).
#   Without it the Apple button stays disabled; the buyer app's native Apple
#   sign-in offers no Services ID, so this must be created in the Apple portal.
NEXT_PUBLIC_APPLE_CLIENT_ID=