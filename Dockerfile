FROM node:22-slim AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG NEXT_PUBLIC_BUYER_APP_STORE=
ARG NEXT_PUBLIC_BUYER_PLAY_STORE=
ARG NEXT_PUBLIC_BUSINESS_APP_STORE=
ARG NEXT_PUBLIC_BUSINESS_PLAY_STORE=
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS=
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_APPLE_CLIENT_ID=
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_BUYER_APP_STORE=$NEXT_PUBLIC_BUYER_APP_STORE
ENV NEXT_PUBLIC_BUYER_PLAY_STORE=$NEXT_PUBLIC_BUYER_PLAY_STORE
ENV NEXT_PUBLIC_BUSINESS_APP_STORE=$NEXT_PUBLIC_BUSINESS_APP_STORE
ENV NEXT_PUBLIC_BUSINESS_PLAY_STORE=$NEXT_PUBLIC_BUSINESS_PLAY_STORE
ENV NEXT_PUBLIC_GOOGLE_ANALYTICS=$NEXT_PUBLIC_GOOGLE_ANALYTICS
ENV NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_APPLE_CLIENT_ID=$NEXT_PUBLIC_APPLE_CLIENT_ID

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . .
RUN yarn build

FROM node:22-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
